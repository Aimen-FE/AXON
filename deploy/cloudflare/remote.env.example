# Copiar a data/atlas-demo/remote.env (privado) y completar. No ejecutar como shell.
AXON_REMOTE_DEMO=true
AXON_DATA_DIR=data/atlas-demo
AXON_DEMO=true
AXON_COOKIE_SECURE=true
AXON_PUBLIC_HOSTNAME=RELLENAR_DOMINIO_AUTORIZADO
AXON_ALLOWED_ORIGINS=RELLENAR_ORIGEN_HTTPS_EXACTO
AXON_ACCESS_ISSUER=RELLENAR_EMISOR_ACCESS_HTTPS
AXON_ACCESS_AUDIENCE=RELLENAR_AUDIENCIA_ACCESS
AXON_AI_MODE=auto
AXON_OLLAMA_MODEL=llama3.2:3b
