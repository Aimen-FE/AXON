AXON_DEMO=false
AXON_AI_MODE=auto
AXON_OLLAMA_URL=http://127.0.0.1:11434
AXON_OLLAMA_MODEL=llama3.2:3b
AXON_AI_TIMEOUT=60
AXON_COOKIE_SECURE=false
AXON_HOST=127.0.0.1
AXON_PORT=8000
# Por defecto usa SQLite dentro de AXON_DATA_DIR.
# AXON_DATA_DIR=data
# Para HTTPS externo, usa el nombre y el origen exactos y activa AXON_COOKIE_SECURE.
# AXON_ALLOWED_HOSTS=axon.example.org
# AXON_ALLOWED_ORIGINS=https://axon.example.org

# Opcionales; no añadas secretos a Git ni al ejemplo.
# AXON_SEARCH_URL=https://tu-proveedor-publico.example/search
# AXON_GOOGLE_CLIENT_ID=
# AXON_GOOGLE_CLIENT_SECRET=

# Opcional. Autoriza únicamente la comprobación pública de conexión desde esta web estática.
# AXON_PAGES_ORIGIN=https://aimen-fe.github.io
